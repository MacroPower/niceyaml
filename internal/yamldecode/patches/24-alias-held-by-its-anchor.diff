+// readsOpenAlias reports whether a read of node into a value of type typ
+// takes node as null. Such a node leads, through its tags, anchors, and
+// aliases, to an alias inside the anchor that it names. The anchors that
+// ctx opens count, and so does each anchor that the walk reads. A tag on
+// the walk still applies to a scalar, or to a pointer to one. nodeToValue
+// reads the tag of the alias for those. Only maps, structs, slices, and
+// arrays, and pointers to them, read a tagged alias as null.
+func (d *Decoder) readsOpenAlias(ctx context.Context, typ reflect.Type, node ast.Node) bool {
+	open := getAnchorMap(ctx)
+	read := map[string]struct{}{}
+	isOpen := func(key string) bool {
+		_, inCtx := open[key]
+		_, inRead := read[key]
+		return inCtx || inRead
+	}
+	tagged := false
+	for {
+		switch n := node.(type) {
+		case *ast.TagNode:
+			tagged = true
+			node = n.Value
+		case *ast.AnchorNode:
+			read[d.anchorKey(n)] = struct{}{}
+			node = n.Value
+		case *ast.AliasNode:
+			key := d.aliasKey(n)
+			if isOpen(key) {
+				if !tagged {
+					return true
+				}
+				switch baseType(typ).Kind() {
+				case reflect.Map, reflect.Struct, reflect.Slice, reflect.Array:
+					return true
+				}
+				return false
+			}
+			read[key] = struct{}{}
+			node = d.anchorNodeMap[key]
+		default:
+			return false
+		}
+	}
+}
