+// keyAlias returns the alias that key is, also under the `?` of an
+// explicit key, a tag, or an anchor. It returns nil for any other key.
+func keyAlias(key ast.Node) *ast.AliasNode {
+	for {
+		switch k := key.(type) {
+		case *ast.MappingKeyNode:
+			key = k.Value
+		case *ast.TagNode:
+			key = k.Value
+		case *ast.AnchorNode:
+			key = k.Value
+		case *ast.AliasNode:
+			return k
+		default:
+			return nil
+		}
+	}
+}
